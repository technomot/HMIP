<Window x:Class="EcdsaLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digital Signature"
        Width="820" Height="760" MinWidth="720" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5FB"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Field" Color="#F7F8FC"/>
        <SolidColorBrush x:Key="Line" Color="#E2E6F0"/>
        <SolidColorBrush x:Key="Accent" Color="#5B5FEF"/>
        <SolidColorBrush x:Key="Text" Color="#1E2433"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Base" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#EEF0FB"/>
            <Setter Property="BorderBrush" Value="#D5DAEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Base}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Base}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="Browse" TargetType="Button" BasedOn="{StaticResource Base}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
            <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource Accent}">
                <TextBlock Text="S" FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Digital Signature" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                <TextBlock Text="ECDSA P-256  |  RIPEMD-160" FontSize="12.5" Margin="0,3,0,0"
                           Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="16" Padding="24">
            <StackPanel>
                <TextBlock Text="FILE" Style="{StaticResource Label}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFile" Style="{StaticResource Input}"/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource Browse}" Click="BrowseFile_Click"/>
                </Grid>

                <TextBlock Text="SIGNATURE FILE" Style="{StaticResource Label}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSignature" Style="{StaticResource Input}"/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource Browse}" Click="BrowseSignature_Click"/>
                </Grid>

                <TextBlock Text="PRIVATE KEY" Style="{StaticResource Label}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPrivate" Style="{StaticResource Input}"/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource Browse}" Click="BrowsePrivate_Click"/>
                </Grid>

                <TextBlock Text="PUBLIC KEY" Style="{StaticResource Label}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPublic" Style="{StaticResource Input}"/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource Browse}" Click="BrowsePublic_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnGenerate" Content="Generate keys" Margin="0,0,10,0"
                    Style="{StaticResource Base}" Click="Generate_Click"/>
            <Button x:Name="BtnSign" Grid.Column="1" Content="Sign" Margin="0,0,10,0"
                    Style="{StaticResource Primary}" Click="Sign_Click"/>
            <Button x:Name="BtnVerify" Grid.Column="2" Content="Verify"
                    Style="{StaticResource Base}" Click="Verify_Click"/>
            <Button Grid.Column="4" Content="Clear log" Style="{StaticResource Ghost}" Click="ClearLog_Click"/>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="16" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="ACTIVITY LOG" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Border x:Name="StatusPill" HorizontalAlignment="Right" CornerRadius="12"
                            BorderThickness="1" BorderBrush="{StaticResource Line}" Padding="12,4">
                        <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}"/>
                    </Border>
                </Grid>
                <TextBox x:Name="TxtLog" Grid.Row="1" Style="{StaticResource Input}" IsReadOnly="True"
                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </Grid>
        </Border>
    </Grid>
</Window>