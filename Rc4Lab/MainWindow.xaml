<Window x:Class="Rc4Lab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RC4 Cipher"
        Width="1000" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Teal" Color="#14B8A6"/>
        <SolidColorBrush x:Key="TealDark" Color="#0F766E"/>
        <SolidColorBrush x:Key="TealSoft" Color="#E3F6F4"/>
        <SolidColorBrush x:Key="FieldBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="LineSoft" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMain" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#14B8A6" Offset="0"/>
            <GradientStop Color="#0EA5E9" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>

        <Style x:Key="SoftTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TealDark}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Teal}"/>
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftPasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TealDark}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Teal}"/>
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Teal}"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TealDark}"/>
            <Setter Property="Background" Value="{StaticResource TealSoft}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="23"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GradientButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource BrandGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Teal}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="26" Background="{StaticResource BrandGradient}" Padding="28">
            <Grid>
                <Ellipse Width="200" Height="200" Fill="White" Opacity="0.12"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"/>
                <Ellipse Width="120" Height="120" Fill="White" Opacity="0.14"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,70"/>

                <StackPanel>
                    <Border Width="60" Height="60" CornerRadius="30" Background="White" HorizontalAlignment="Left">
                        <TextBlock Text="R" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TealDark}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RC4 Cipher" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,22,0,4"/>
                    <TextBlock Text="Fast and simple stream encryption for any file."
                               FontSize="13.5" Foreground="White" Opacity="0.9" TextWrapping="Wrap" LineHeight="20"/>

                    <StackPanel Margin="0,34,0,0">
                        <TextBlock Text="Stream cipher, byte by byte" Foreground="White" FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock Text="Student:Mahammad Mammadov" Foreground="White" FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock Text="Group:KH-923i.e" Foreground="White" FontSize="13" Margin="0,0,0,12"/>
                        <TextBlock Text="SHA-256 integrity check" Foreground="White" FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Laboratory work 6  |  Variant 6" Foreground="White" Opacity="0.8" FontSize="12"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,430,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="26" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#0F172A"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Protect your file" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="Choose a file, enter a key and press Encrypt or Decrypt."
                               FontSize="13.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="INPUT FILE" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInput" Style="{StaticResource SoftTextBox}"
                                 AllowDrop="True" PreviewDragOver="Input_DragOver" PreviewDrop="Input_Drop"/>
                        <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                Style="{StaticResource BrowseButton}" Click="BrowseInput_Click"/>
                    </Grid>

                    <TextBlock Text="OUTPUT FILE" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtOutput" Style="{StaticResource SoftTextBox}"/>
                        <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                Style="{StaticResource BrowseButton}" Click="BrowseOutput_Click"/>
                    </Grid>

                    <TextBlock Text="KEY (PASSWORD)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="TxtKey" Style="{StaticResource SoftPasswordBox}"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnEncrypt" Grid.Column="0" Content="Encrypt" Margin="0,0,10,0"
                            Style="{StaticResource GradientButton}" Click="Encrypt_Click"/>
                    <Button x:Name="BtnDecrypt" Grid.Column="1" Content="Decrypt" Margin="0,0,10,0"
                            Style="{StaticResource PillButton}" Click="Decrypt_Click"/>
                    <Button x:Name="BtnVerify" Grid.Column="2" Content="Verify integrity"
                            Style="{StaticResource OutlineButton}" Click="Verify_Click"/>
                    <Button Grid.Column="4" Content="Clear log"
                            Style="{StaticResource GhostButton}" Click="ClearLog_Click"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,24,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ACTIVITY" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#94A3B8"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="{StaticResource LineSoft}"
                        BorderThickness="1" CornerRadius="16" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Margin="0,0,0,10"
                                     BorderThickness="0" Background="#E2E8F0" Foreground="{StaticResource Teal}"
                                     Visibility="Collapsed"/>
                        <TextBox x:Name="TxtLog" Grid.Row="1" Style="{StaticResource LogTextBox}"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>