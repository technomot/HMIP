<Window x:Class="PasswordProtectionApp.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Protection System - User Mode"
        Height="300" Width="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_User">
                <MenuItem Header="_Change Password" Click="ChangePassword_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About the program" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="Change Password" Click="ChangePassword_Click" Padding="6,2">Change Password</Button>
                <Separator/>
                <Button ToolTip="Exit" Click="Exit_Click" Padding="6,2">Exit</Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="You are logged in as a regular user." Margin="0,10,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Use the User menu to change your password or exit." Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>