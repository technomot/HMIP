<Window x:Class="PasswordProtectionApp.SetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Password"
        Height="340" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,0,0,8" x:Name="OldPasswordRow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Old password:" VerticalAlignment="Center"/>
            <PasswordBox x:Name="OldPasswordBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center" PasswordChar="*"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="New password:" VerticalAlignment="Center"/>
            <PasswordBox x:Name="NewPasswordBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center" PasswordChar="*"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Confirm new password:" VerticalAlignment="Center"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center" PasswordChar="*"/>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="RuleText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>

        <TextBlock Grid.Row="5" x:Name="StatusText" Foreground="Red" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="90" Height="28" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="28" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>