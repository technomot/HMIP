<Window x:Class="KnufuLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KNUFU Cipher"
        Width="820" Height="720" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5FB"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgField" Color="#F7F8FC"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2E6F0"/>
        <SolidColorBrush x:Key="Accent" Color="#5B5FEF"/>
        <SolidColorBrush x:Key="TextMain" Color="#1E2433"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource BgField}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C5CBE0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource BgField}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C5CBE0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#EEF0FB"/>
            <Setter Property="BorderBrush" Value="#D5DAEE"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D5DAEE"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
            <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource Accent}">
                <TextBlock Text="K" FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="KNUFU Cipher" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="64-bit block  |  512-bit key  |  CBC mode  |  File encryption"
                           FontSize="12.5" Margin="0,3,0,0" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1" CornerRadius="16" Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#1E2433"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="INPUT FILE" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtInput" Style="{StaticResource ModernTextBox}"
                             AllowDrop="True" PreviewDragOver="Input_DragOver" PreviewDrop="Input_Drop"/>
                    <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                            Style="{StaticResource BrowseButton}" Click="BrowseInput_Click"/>
                </Grid>

                <TextBlock Text="OUTPUT FILE" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtOutput" Style="{StaticResource ModernTextBox}"/>
                    <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                            Style="{StaticResource BrowseButton}" Click="BrowseOutput_Click"/>
                </Grid>

                <TextBlock Text="KEY (PASSWORD)" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="TxtKey" Style="{StaticResource ModernPasswordBox}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnEncrypt" Grid.Column="0" Content="Encrypt" Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButton}" Click="Encrypt_Click"/>
            <Button x:Name="BtnDecrypt" Grid.Column="1" Content="Decrypt" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}" Click="Decrypt_Click"/>
            <Button x:Name="BtnVerify" Grid.Column="2" Content="Verify integrity"
                    Style="{StaticResource SecondaryButton}" Click="Verify_Click"/>
            <Button Grid.Column="4" Content="Clear log"
                    Style="{StaticResource GhostButton}" Click="ClearLog_Click"/>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1" CornerRadius="16" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#1E2433"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="ACTIVITY LOG" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <Border x:Name="StatusPill" HorizontalAlignment="Right" CornerRadius="12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderSoft}" Padding="12,4">
                        <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"/>
                    </Border>
                </Grid>
                <TextBox x:Name="TxtLog" Grid.Row="1" Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </Grid>
        </Border>
    </Grid>
</Window>